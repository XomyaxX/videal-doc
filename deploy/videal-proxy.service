[Unit]
Description=videal LLM outbound proxy (mihomo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=v
Group=v
WorkingDirectory=/etc/videal-proxy
ExecStart=/usr/local/bin/mihomo -d /etc/videal-proxy -f /etc/videal-proxy/config.yaml
Restart=on-failure
RestartSec=4
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
